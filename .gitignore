decomp/ghidra_proj/
decomp/ovl/
decomp/*.unp.exe
tmp/
*.o
*.exe
!orig/*.EXE
__pycache__/
tests/*.exe

# What JW_CAD leaves behind when it runs under dosv_emu_cpp: an empty
# auto-save file at startup and a list of the drawings that were opened.
# Neither is in jwcv222h.lzh -- orig/ is the distribution, unchanged.
#
# **They are kept in q/, not in orig/.**  A stray .JWC in orig/ is baked
# into both .wasm builds by --embed-file and then listed on both pages, and
# in ②読込's own list, as though it shipped with the program.  That is how
# AUTO.JWC came to look like the drawing the page had opened.
q/AUTO.JWC
orig/AUTO.JWC
orig/JW_FILE0.*

# The question drawings tools/onlykind.py, tools/onerec.py and tools/mkarcs.py
# write for the original to read. They go into orig/ because that is the
# directory the guest sees, and they are made again whenever they are needed.
orig/ONE.JWC
orig/T2TEXT.JWC
orig/S?ARCS.JWC
orig/S?LINE.JWC
orig/S?TEXT.JWC
orig/S?POIN.JWC
orig/T?ARCS.JWC
orig/T?LINE.JWC
orig/T?TEXT.JWC
orig/T?POIN.JWC
orig/ARCS*.JWC
orig/ASK.JWC
orig/QPICK.JWC
q/QPICK.JWC
orig/QLAYER.JWC
orig/QBYTES.JWC
q/QBYTES.JWC
